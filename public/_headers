# Cloudflare Workers static-asset headers.
# https://developers.cloudflare.com/workers/static-assets/headers
#
# These filenames contain a content hash, so a new build produces new URLs.
# Cache them for a year instead of the Workers default (max-age=0, which makes
# every repeat visit revalidate every script and stylesheet).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
