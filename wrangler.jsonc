{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker name is the first label of the free workers.dev URL.
  // Deploying under a new name creates a new Worker; re-set its secrets and
  // update the Supabase auth URLs before retiring the old Worker.
  "name": "bookings",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  // Frontend hostnames that Turnstile siteverify may return. Update this list
  // when the custom domain is connected; keep localhost out of production.
  "vars": {
    "TURNSTILE_HOSTNAMES": "bookings.dhiddenpickleball.workers.dev"
  },
  // The app gates /staff in proxy.ts and sets the Phase 10 baseline security
  // headers in next.config.ts, so page, server-action and API requests have to
  // reach the Worker. Built assets do not: proxy.ts already skips them, and
  // static-asset requests are free and unlimited on the free plan, while a
  // Worker-served asset burns a request, a 10 ms CPU budget, and a log event.
  // A page load references ~37 of them, so the negative rules below keep them
  // on the asset layer. Negative rules take precedence; every other path still
  // matches "/*" and runs the Worker exactly as before.
  //
  // List files individually, never a whole public directory: a negative rule
  // such as "!/courts/*" also captures the /courts/court-1 and /courts/court-2
  // app routes, which exist only in the Worker, so those links returned 404.
  // Add new public files here as exact paths.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/courts/pickleball1.jpg",
      "!/courts/pickleball2.jpg",
      "!/courts/pickleball2-960.webp",
      "!/courts/pickleball2-1376.webp",
      "!/logo/hidden-pickleball.ico",
      "!/logo/hidden-pickleball.png",
      "!/logo/hidden-pickleball.webp",
      "!/email-logo.png",
      "!/qr/client-official-gcash-qr.jpg",
      "!/qr/gcash-sample.jpg",
      "!/qr/gcash-test-qr.png",
      "!/vendor/maplibre-gl-worker.mjs",
      "!/favicon.ico",
      "!/file.svg",
      "!/globe.svg",
      "!/next.svg",
      "!/vercel.svg",
      "!/window.svg"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Request logs and errors, for launch monitoring. Only Worker invocations are
  // logged, so asset traffic no longer counts toward the event allowance.
  "observability": {
    "enabled": true
  }
  // Custom domain: add once the club's domain is confirmed, e.g.
  // "routes": [{ "pattern": "bookings.example.com", "custom_domain": true }]
  //
  // Image optimization: next/image serves the ORIGINAL file while no IMAGES
  // binding exists. The club's photos are already pre-sized in public/, so
  // this is fine and keeps the deployment on the free plan. Adding
  // "images": { "binding": "IMAGES" } enables on-the-fly resizing on the paid
  // Cloudflare Images plan.
  //
  // Secrets are NOT set here. Use `wrangler secret put <NAME>` for the
  // server-only values listed in .env.example. NEXT_PUBLIC_* values are inlined
  // at build time, so they must be present when `npm run deploy` builds.
}
