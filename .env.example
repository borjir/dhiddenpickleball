# Supabase development project.
# Copy this file to .env.local and fill in the values from
# Supabase Dashboard > Project Settings > API.
# Never commit .env.local or a secret/service-role key.

# NEXT_PUBLIC_* values are inlined at BUILD time, so they must be present in the
# environment that runs the deploy build (see docs/DEPLOYMENT_CLOUDFLARE.md).
# The server-only values below are Worker secrets: `npx wrangler secret put <NAME>`.
NEXT_PUBLIC_SUPABASE_URL=https://ybgcktpyntpcragegwec.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0gi2SPMpYOh1XtLqLWLkDw_HEr331nP

# Mailjet transactional email. Both credentials are server-only secrets; never
# expose either with a NEXT_PUBLIC_ prefix or commit them. Use the API key and
# secret from Mailjet > Account > API Key Management. The free plan allows 200
# sends/day and 6,000/month.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# This is a verified sender EMAIL ADDRESS, not the deployed site URL. Plain
# address or "Name <address>" works. Mailjet requires the sender address or its
# domain to be validated before it will deliver to guests.
EMAIL_FROM="D-Hidden Pickleball <bookings@your-verified-domain.example>"
EMAIL_REPLY_TO=gracemilan87@gmail.com
# Keep the app below the Mailjet free-plan limits. The defaults are 200/day and
# 6,000/month, so these lines are optional unless you need a different cap.
EMAIL_DAILY_LIMIT=200
EMAIL_MONTHLY_LIMIT=6000
# Retained for staff alerts, which are currently disabled to conserve quota.
# Staff use the dashboard as the source of truth.
STAFF_NOTIFICATION_EMAILS=
EMAIL_CRON_SECRET=
# Public HTTPS origin used in email links and the email logo. Use the deployed
# origin for production. For local-only development you may override this with
# http://localhost:3000, but the Supabase Site URL and redirect allow-list must
# also include that origin (see supabase/config.toml).
NEXT_PUBLIC_SITE_URL=https://bookings.dhiddenpickleball.workers.dev
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile. The site key is public and can be committed. The secret
# is server-only: set it with `npx wrangler secret put TURNSTILE_SECRET` for the
# Worker and in .env.local for local development.
# TURNSTILE_HOSTNAMES must list the exact frontend hostnames that siteverify may
# return. Never include localhost or 127.0.0.1 in the production allowlist.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAF54oP0dhgASYym3
TURNSTILE_HOSTNAMES=bookings.dhiddenpickleball.workers.dev
TURNSTILE_SECRET=
